# ============================================================================
# Household of David Lekki Centre — repository ignore rules
# ============================================================================

# Environment variables (secrets, DB creds, API keys, vault keys)
.env
.env.local
.env.*.local

# System logs & cPanel remnants (anchored so nested webhook/.htaccess etc.
# CAN be tracked — only the docroot's cPanel-generated files are ignored)
error_log
*.log
/.htaccess
/.user.ini
cgi-bin/

# PHP dependencies (managed via composer.json / composer.lock).
# ROOT-ANCHORED: an unanchored "vendor/" also swallowed assets/se/vendor/,
# the Special Events module's vendored front-end libraries, which MUST be
# committed because the cPanel host has no Node (guide §8.6.1, §21.3).
/vendor/
/composer.phar

# Front-end tooling / node
node_modules
tailwindcss-linux-x64
tailwindcss-macos-*
tailwindcss-windows-*

# IDE / OS junk
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Runtime / user uploads (member media, sermon audio, event banners, etc.)
uploads/
assets/uploads/

# Special Events live snapshots (runtime). Keep the folder's .htaccess and
# .keep tracked so the deploy creates the directory (guide §21.3, §23.1).
live/*
!live/.htaccess
!live/.keep

# Ad-hoc / staging folders
gk/

# Database dumps and structural backups
*.sql
*.sql.gz
*.dump
# ...but forward migrations under db/migrations/ ARE tracked; they run on
# every deploy via db/migrate.php.
!db/migrations/*.sql

# Ad-hoc scratch scripts — never commit
_scratch/
scratch_*.php
