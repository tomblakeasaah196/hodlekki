# rsync --exclude-from patterns used by .cpanel.yml when copying
# /home/smartqaq/repositories/hodlekki/  →  /home/smartqaq/public_html/hodlc.lpc.cm/
#
# Anything listed here is skipped during the copy AND, because of how
# rsync --delete interacts with --exclude, is NOT deleted from the docroot
# if it already exists there. That is how we preserve runtime files like
# .env, .htaccess, and uploads/ across deploys.

# Git internals & CI files (never belong in the docroot)
.git/
.github/
.cpanel.yml
.deployignore

# Environment / secrets (docroot copy is authoritative)
.env
.env.local
.env.*.local

# cPanel-generated PHP config (docroot copy is authoritative)
.htaccess
.user.ini
php.ini

# Runtime member/media uploads (docroot copy is authoritative)
uploads/
assets/uploads/

# PHP error logs (per-directory, generated at runtime)
error_log
**/error_log

# Vendored dependencies — regenerated by `composer install` in the deploy step
vendor/

# Local dev tooling & artefacts
composer.phar
tailwindcss-linux-x64
node_modules/
input.css
tailwind.config.js

# IDE / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
