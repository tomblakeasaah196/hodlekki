# =========================================================================
# Household of David Lekki Centre - Environment Configuration Template
# =========================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Database Connection Credentials
DB_HOST="localhost"
DB_NAME=""
DB_USER=""
DB_PASS=""

# Google Gemini LLM API Configuration
GEMINI_API_KEY=""

# SMS Studio (BulkSMS) — AES-256-GCM key that encrypts the sms_settings row.
# Generate a fresh key with:
#   php -r "echo bin2hex(random_bytes(32));"
# NOTE: rotating this key invalidates any already-encrypted BulkSMS tokens
# stored in the `sms_settings` table.
SMS_VAULT_KEY=""

# SMS Studio delivery-report webhook. BulkSMS calls
#   https://<site>/api/sms_webhook.php?token=<this value>
# (SMS Studio → Settings → "Use this site's webhook URL" fills it in).
# Optional: without it the queue worker polls BulkSMS for delivery reports.
# Generate with: php -r "echo bin2hex(random_bytes(24));"
SMS_WEBHOOK_SECRET=""

# Geoapify (client-side address autocomplete). Restrict by domain in the
# Geoapify dashboard; this value is inlined into pages served to browsers.
GEOAPIFY_API_KEY=""

# Deploy webhook shared secret. GitHub Actions POSTs to
# https://hodlc.lpc.cm/webhook/deploy.php with header X-Deploy-Token
# matching this value; requests without a matching header are rejected
# with 401. Must be at least 32 characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
DEPLOY_WEBHOOK_SECRET=""
