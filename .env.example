# =========================================================================
# Household of David Lekki Centre - Environment Configuration Template
# =========================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Database Connection Credentials
DB_HOST="localhost"
DB_NAME=""
DB_USER=""
DB_PASS=""

# Google Gemini LLM API Configuration
GEMINI_API_KEY=""

# SMS Studio (BulkSMS) — AES-256-GCM key that encrypts the sms_settings row.
# Generate a fresh key with:
#   php -r "echo bin2hex(random_bytes(32));"
# NOTE: rotating this key invalidates any already-encrypted BulkSMS tokens
# stored in the `sms_settings` table.
SMS_VAULT_KEY=""

# SMS Studio delivery-report webhook. BulkSMS calls
#   https://<site>/api/sms_webhook.php?token=<this value>
# (SMS Studio → Settings → "Use this site's webhook URL" fills it in).
# Optional: without it the queue worker polls BulkSMS for delivery reports.
# Generate with: php -r "echo bin2hex(random_bytes(24));"
SMS_WEBHOOK_SECRET=""

# Geoapify (client-side address autocomplete). Restrict by domain in the
# Geoapify dashboard; this value is inlined into pages served to browsers.
GEOAPIFY_API_KEY=""

# Deploy webhook shared secret. GitHub Actions POSTs to
# https://hodlekki.org/webhook/deploy.php with header X-Deploy-Token
# matching this value; requests without a matching header are rejected
# with 401. Must be at least 32 characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
DEPLOY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Special Events module (guide §20.1)
# ---------------------------------------------------------------------------

# REQUIRED by the module. HMAC key for manage-link tokens, device cookies and
# the hashing of IPs and user agents. Without it the module refuses to issue
# tokens and logs a clear line. Rotating it invalidates every device cookie
# and manage link, so only do that after an incident.
#   php -r "echo bin2hex(random_bytes(32));"
SE_HASH_PEPPER=""

# Gemini models behind se_ai(). The key itself is GEMINI_API_KEY above, which
# the module reuses. Both default to gemini-2.5-flash when unset OR left
# blank — SE_AI_MODEL_VISION is the one that reads a programme screenshot or
# PDF, so name a model here only if you mean to override the default.
SE_AI_MODEL_TEXT=""
SE_AI_MODEL_VISION=""

# Trainings AI help (includes/exams/ai.php): the church's daily Gemini allowance
# in tokens, shared by everyone using it. Blank = 1500000 (about US$1-4 a day
# at Gemini 2.5 Flash prices). It resets at midnight, Lagos time.
TRAININGS_AI_DAILY_TOKENS=""

# Our sermons' AI drafts (includes/our_sermons/ai.php): the daily Gemini
# allowance in tokens for listening to sermons and drafting their summaries.
# Gemini counts audio at 32 tokens a second, so a 35-minute sermon (the Lekki
# show's usual) is about 70000. Blank = 600000 (about 8 such sermons, at most
# about US$0.60 a day at Gemini 2.5 Flash audio prices). It resets at midnight,
# Lagos time; a sermon that would pass it waits for the next day.
SERMONS_AI_DAILY_TOKENS=""

# The hosts the sermon audio may be downloaded from, redirects included
# (comma-separated; "*.example.net" means its subdomains). Blank = the Lekki
# show's: anchor.fm,*.anchor.fm,*.cloudfront.net (anchor.fm's play address
# redirects to CloudFront). Set it only if the podcast moves host.
SERMONS_AI_AUDIO_HOSTS=""

# Gemini models behind hymnal_ai(), which reads a song the music team pastes or
# photographs in the Hymnary Studio. Both reuse GEMINI_API_KEY above. Leave
# these blank and the Hymnary falls back to the SE_AI_MODEL_* values, and then
# to gemini-2.5-flash, so one key and one model choice serve both modules —
# set them only to give the Hymnary a different model from Special Events.
#
# With no GEMINI_API_KEY at all the Studio simply hides the "read this for me"
# buttons and says so; typing a song in by hand always works.
HYMNAL_AI_MODEL_TEXT=""
HYMNAL_AI_MODEL_VISION=""

# Realtime driver: "poll" (v1 — static JSON snapshots that LiteSpeed serves
# without starting PHP) or "ably" (reserved; needs ABLY_API_KEY).
SE_REALTIME_DRIVER="poll"
ABLY_API_KEY=""

# Bible verse lookup for welcome cards and game content. KJV, public domain.
SE_BIBLE_API_BASE="https://bible-api.com"

# ---------------------------------------------------------------------------
# Installable app (PWA) + Web Push — docs/pwa_push.md
# ---------------------------------------------------------------------------

# VAPID identity. This P-256 keypair is how a push service (Google's FCM,
# Mozilla's, Apple's) knows a notification really came from this site: the
# public half is handed to the browser when a member subscribes, the private
# half signs a short-lived JWT on every send. Generate both with:
#   php bin/generate_vapid_keys.php "mailto:asah.tomf@gmail.com"
#
# OPTIONAL. Left blank, includes/push_helpers.php generates a pair on first
# use and stores it in the `push_config` table, so push works the moment the
# migration runs. Keys here are still better: they survive a database restore
# taken from before the feature existed, and the private half stays out of
# nightly SQL dumps.
#
# ROTATING THESE INVALIDATES EVERY EXISTING SUBSCRIPTION — a push service ties
# a subscription to the public key it was created with, and nothing tells the
# congregation to opt in again. Generate once, keep.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact the push service can reach if our traffic causes it a problem.
# Must be a mailto: or https: URL (RFC 8292). Falls back to the site origin.
VAPID_SUBJECT="mailto:asah.tomf@gmail.com"

# The site's public address (includes/site_url.php). Every link that leaves
# the browser — QR codes, SMS, push, emails, printed posters, share cards — is
# built from it, never from the request's host, so a link made on
# connect.hodlekki.org or the old hodlc.lpc.cm still points at the real site.
# Set it in production. Empty: the request's own host, then https://hodlekki.org.
SITE_URL="https://hodlekki.org"

# Optional. The public Connect page's own address; connect.<SITE_URL host>
# when empty. Its root shows connect.php (index.php).
CONNECT_URL=""

# ---------------------------------------------------------------------------
# The Bible — modules/bible/how_to_use.md (section 7)
# ---------------------------------------------------------------------------

# API.Bible (American Bible Society) key for NKJV, NIV and AMP. The KJV is
# built in and needs nothing. Free "Starter" plan at https://api.bible:
# non-commercial, public-domain Bibles plus up to three licensed ones.
# Blank = only the KJV is offered.
BIBLE_API_KEY=""

# Optional. Default https://rest.api.bible/v1. Must be https.
BIBLE_API_BASE=""

# Optional. Stop calling API.Bible after this many calls in a calendar month
# (the Starter plan allows about 5,000). Default 4500.
BIBLE_API_MONTHLY_CAP=""

# Optional. Pin the API.Bible Bible id for a translation instead of letting
# the module find it in the key's catalogue (Bible → KJV → API.Bible status).
BIBLE_API_ID_NKJV=""
BIBLE_API_ID_NIV=""
BIBLE_API_ID_AMP=""

# Optional. Where the reader's browser reports API.Bible fair-use (FUMS)
# events. Default https://fums.api.bible/f3 — change only if API.Bible's
# Fair Use guide gives a different endpoint.
BIBLE_FUMS_URL=""

# ---------------------------------------------------------------------------
# Origin lock — bin/edge_lock.sh (DEPLOY.md, "Addresses and the origin lock")
# ---------------------------------------------------------------------------

# Cloudflare adds this secret as the X-Hodlekki-Edge header to every request it
# forwards (a Transform Rule in the hodlekki.org zone); with it set, the site
# refuses requests that went around Cloudflare. Add it to .env ONLY after the
# Cloudflare rule sends the same value, then deploy (or run bin/edge_lock.sh),
# or everyone is locked out. 32-128 letters and digits. Empty: no lock.
EDGE_TOKEN=""

# ---------------------------------------------------------------------------
# Outgoing email — includes/mailer.php (bin/mail_test.php sends a test)
# ---------------------------------------------------------------------------

# SMTP through this server's own mail service, as nfelia.com does. The app
# sends from system@hodlekki.org; replies go to embrace@hodlekki.org, which
# the follow-up team reads. MAIL_PASSWORD is the system@ mailbox's password.
MAIL_HOST="localhost"
MAIL_PORT="465"
MAIL_ENCRYPTION="ssl"
MAIL_USERNAME="system@hodlekki.org"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="system@hodlekki.org"
MAIL_FROM_NAME="Household of David Lekki"
MAIL_REPLY_TO="embrace@hodlekki.org"
MAIL_REPLY_TO_NAME="HOD Lekki Embrace Team"

# Account mail through ZeptoMail (Zoho CPaaS), 26 Nov 2026: codes, reset links,
# confirmations and alerts. The shared host caps hodlekki.org at 20 emails an
# hour and drops the rest, so account mail goes around it; church news stays
# on the host. Leave ACCOUNT_MAIL_HOST empty to send everything through the host.
# The password is the agent's "Send Mail token" (ZeptoMail > Agents > SMTP/API,
# "More secure credentials", Password 1). This host blocks outgoing SMTP to
# other servers, so for ZeptoMail the app sends over HTTPS to
# https://cpaas.zoho.com/v1.1/email with that same token (ACCOUNT_MAIL_API_KEY
# overrides it; ACCOUNT_MAIL_TRANSPORT="smtp" forces SMTP on another host).
# Test: php bin/mail_test.php you@example.com --account
#
# Backup: Brevo's API, used when ZeptoMail cannot take a message (no credit, a
# bad token, an outage); never for a wrong address. Its own API key (xkeysib-…,
# Brevo > SMTP & API > API keys). Test: php bin/mail_test.php you@example.com --backup
ACCOUNT_MAIL_BACKUP_API_KEY=""
ACCOUNT_MAIL_HOST="smtp.zeptomail.com"
ACCOUNT_MAIL_PORT="587"
ACCOUNT_MAIL_ENCRYPTION="tls"
ACCOUNT_MAIL_USERNAME="emailapikey"
ACCOUNT_MAIL_PASSWORD=""

# ---------------------------------------------------------------------------
# Mail: the church's mailboxes in the ERP — docs/MAIL.md
# ---------------------------------------------------------------------------

# Encrypts every mailbox password the ERP keeps (AES-256-GCM). 64 hex characters,
# made ON THE SERVER: php -r "echo bin2hex(random_bytes(32));"   Its own key, not
# SMS_VAULT_KEY. To change it: put the old one in MAIL_VAULT_KEY_PREVIOUS, the new
# one here, run bin/mail_rekey.php, then remove the old one. Lost it? bin/mail_rekey.php
# --reset-all gives every mailbox a new password through cPanel; nobody types any.
MAIL_VAULT_KEY=""
MAIL_VAULT_KEY_PREVIOUS=""

# The domain the ERP makes mailboxes in, and how many it may hold (owner: 15).
MAIL_DOMAIN="hodlekki.org"
MAIL_DOMAIN_QUOTA="15"

# The mail server (defaults shown). If Dovecot does not present a certificate for
# mail.hodlekki.org (bin/mail_doctor.php says), use the server's own host name here;
# never turn certificate checks off.
# The server's own name: its mail certificate does not cover mail.hodlekki.org.
# MAIL_IMAP_HOST="srv-web-ns9.newtoncorp.fr"
# MAIL_SMTP_HOST="srv-web-ns9.newtoncorp.fr"

# No cPanel token: the crons use the server's own uapi command. Unset: the first of /usr/bin/uapi and
# /usr/local/cpanel/bin/uapi this account can run (the second fails under CageFS on this host).
# MAIL_UAPI_BINARY="/usr/bin/uapi"
# Where the minute cron writes a line when something fails (default: ~/logs/hod-mail.log)
# MAIL_LOG_FILE="/home/smartqaq/logs/hod-mail.log"

# ---------------------------------------------------------------------------
# The system monitor — docs/monitor.md
# ---------------------------------------------------------------------------

# Shared with the outside probe (GitHub → Settings → Secrets → Actions →
# MONITOR_PROBE_SECRET, the SAME value). Without it the probe still runs but
# the site refuses its reports, and Health says "no report from outside".
#   php -r "echo bin2hex(random_bytes(32));"
MONITOR_PROBE_SECRET=

# Optional, recommended. GitHub skips many scheduled runs of the probe, so when
# no report has come for 70 minutes the monitor cron asks GitHub to run it now
# (at most once in 55 minutes). A fine-grained GitHub token for THIS repository
# only, permission "Actions: Read and write", nothing else. Empty: no asking.
MONITOR_PROBE_KICK_TOKEN=
# The repository the probe runs in (default tomblakeasaah196/hodlekki).
# MONITOR_PROBE_REPO=

# Optional. Signs the browser intake tokens and email stop links, and keys the
# hash that counts people. Left empty, the monitor makes a random key once and
# keeps it in its own folder outside the docroot (~/.hodlekki_monitor/secret.key).
# Set one here (32+ characters) to keep it in .env with the other secrets.
MONITOR_SECRET=

# Optional switches. MONITOR_ENABLED=0 stops all recording (no deploy needed);
# MONITOR_BROWSER=0 leaves the browser script out of pages; MONITOR_RUM_SAMPLE
# (0 to 1, default 1) is the share of page views that report their speed;
# MONITOR_SLOW_MS (default 3000) is when a page counts as slow.
MONITOR_ENABLED=
MONITOR_BROWSER=
MONITOR_RUM_SAMPLE=
MONITOR_SLOW_MS=

# Optional paths. Defaults on the server: /home/<account>/.hodlekki_monitor
# (spool, heartbeats; never under public_html), ~/backups/hodlc (JBS HQ's
# encrypted backups of this site), ~/deploy.log. MONITOR_EXTRA_LOGS is a
# comma-separated list of more log files to read.
MONITOR_DATA_DIR=
MONITOR_BACKUP_DIR=
MONITOR_DEPLOY_LOG=
MONITOR_EXTRA_LOGS=

# ---------------------------------------------------------------------------
# Integrations: Google for Trainings' live classes (Meet links, attendance) — docs/INTEGRATIONS.md
# ---------------------------------------------------------------------------

# The OAuth client (Google Cloud → Credentials → the "Web application" client). Its
# redirect URI must be https://hodlekki.org/integrations/google/callback. The owner
# pastes these; nobody else types them.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Only when the site is not at SITE_URL (a staging copy): the exact registered URI.
GOOGLE_OAUTH_REDIRECT_URI=""

# Encrypts the Google refresh token and the cached access token (AES-256-GCM). 64 hex
# characters, made ON THE SERVER: php -r "echo bin2hex(random_bytes(32));"   Its own key.
# Lost or changed without the old one in _PREVIOUS: an admin presses Connect again.
INTEGRATIONS_VAULT_KEY=""
INTEGRATIONS_VAULT_KEY_PREVIOUS=""
